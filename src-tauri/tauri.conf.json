{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fotoflow",
  "version": "0.1.0",
  "identifier": "com.yasihusain.fotoflow",
  "build": {
    "beforeDevCommand": "bash scripts/build-engine.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/build-engine.sh && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "fotoflow",
        "width": 1280,
        "height": 860,
        "minWidth": 520,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/engine"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
